# Core application
OPSMIND_ENV=development
OPSMIND_LOG_LEVEL=INFO
OPSMIND_INPUT_DIR=data/input
OPSMIND_OUTPUT_DIR=data/output
OPSMIND_MAX_CONCURRENCY=4

# Stage 2: classical ML
OPSMIND_TRAINING_DATA=data/training/incidents.csv
OPSMIND_MODEL_PATH=data/models/incident-classifier.joblib
OPSMIND_ML_TEST_SIZE=0.20
OPSMIND_ML_RANDOM_STATE=42

# Stage 3: from-scratch neural NLP
OPSMIND_NEURAL_MODEL_PATH=data/models/neural-incident-classifier.pt
OPSMIND_NEURAL_VALIDATION_SIZE=0.20
OPSMIND_NEURAL_BATCH_SIZE=8
OPSMIND_NEURAL_EPOCHS=60
OPSMIND_NEURAL_LEARNING_RATE=0.003
OPSMIND_NEURAL_WEIGHT_DECAY=0.0001
OPSMIND_NEURAL_EMBEDDING_DIM=48
OPSMIND_NEURAL_HIDDEN_DIM=48
OPSMIND_NEURAL_MAX_LENGTH=48
OPSMIND_NEURAL_MIN_FREQUENCY=1
OPSMIND_NEURAL_DROPOUT=0.10
OPSMIND_NEURAL_PATIENCE=10

# Stage 3: pretrained Transformer classifier
OPSMIND_TRANSFORMER_MODEL_NAME=distilbert-base-uncased
OPSMIND_TRANSFORMER_MODEL_DIR=data/models/transformer-incident-classifier
OPSMIND_TRANSFORMER_VALIDATION_SIZE=0.20
OPSMIND_TRANSFORMER_BATCH_SIZE=8
OPSMIND_TRANSFORMER_EPOCHS=5
OPSMIND_TRANSFORMER_LEARNING_RATE=0.0005
OPSMIND_TRANSFORMER_WEIGHT_DECAY=0.01
OPSMIND_TRANSFORMER_MAX_LENGTH=96
OPSMIND_TRANSFORMER_PATIENCE=2
OPSMIND_TRANSFORMER_FREEZE_BASE=true

# Stage 4: retrieval / vector database
OPSMIND_RETRIEVAL_SOURCE_DIR=data/knowledge
OPSMIND_RETRIEVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPSMIND_RETRIEVAL_EMBEDDING_BATCH_SIZE=32
OPSMIND_RETRIEVAL_VECTOR_STORE_PATH=data/vector_store/qdrant
# Leave empty for embedded local Qdrant; set a URL only when using an external Qdrant server
OPSMIND_QDRANT_URL=
OPSMIND_RETRIEVAL_COLLECTION_NAME=opsmind_knowledge
OPSMIND_RETRIEVAL_CHUNK_SIZE=80
OPSMIND_RETRIEVAL_CHUNK_OVERLAP=20
OPSMIND_RETRIEVAL_TOP_K=3
OPSMIND_RETRIEVAL_SCORE_THRESHOLD=
OPSMIND_RETRIEVAL_EVALUATION_PATH=data/evaluation/retrieval_queries.json

# Stage 5: RAG generation
# Supported: hf_local | extractive | openai_compatible
OPSMIND_LLM_PROVIDER=hf_local
OPSMIND_LLM_MODEL=google/flan-t5-small
OPSMIND_RAG_MAX_NEW_TOKENS=160
OPSMIND_RAG_MAX_INPUT_TOKENS=512
OPSMIND_RAG_MAX_CONTEXT_CHARS=6000
OPSMIND_RAG_EXTRACTIVE_MAX_CHARS=900
OPSMIND_RAG_EVALUATION_PATH=data/evaluation/rag_queries.json

# Optional OpenAI-compatible provider
OPSMIND_OPENAI_BASE_URL=https://api.openai.com/v1
OPSMIND_OPENAI_API_KEY=
OPSMIND_OPENAI_TIMEOUT_SECONDS=60

# Stage 6: API serving
OPSMIND_API_HOST=127.0.0.1
OPSMIND_API_PORT=8000
